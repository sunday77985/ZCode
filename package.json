{
  "name": "zcode",
  "private": true,
  "version": "0.1.0",
  "description": "ZCode 中文隐私流动性项目启动台",
  "author": "ZCode Contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "electron .",
    "build:win": "npm run build && electron-builder --config build/electron-builder.yml --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true
  }
}
